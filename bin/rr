#!/bin/bash

set -e
set -o pipefail

s=1M
t=~/trash
u=30
y=365
z=--zstd

he () {
    echo -e "-p: purge (${y}d)
-r regex: restore\n
-k: keep
-s size: purge ($s)
-t trash ($t)
-u: uncompressed
-w: 7d to purge"
    exit 1
}

ry () { read -p '? ' r; [ "$r" == y ]; }

[ -z "$1" ] && he

while getopts 'pr:ks:t:uw' o; do
    case "$o" in
        p)
            m=p ;;
        r)
            m=r x=$OPTARG ;;
        k)
            k=1 ;;
        s)
            s=$OPTARG ;;
        t)
            t=$OPTARG ;;
        u)
            z= ;;
        w)
            w=1 ;;
        ?)
            he ;;
    esac
done

shift $(($OPTIND - 1))

[ -e $t ] || mkdir -v $t

case $m in
    p)
        for i in $(find $t/*.tar -mtime +$y -or -mtime +$u -size +$s | xargs -r ls -rt); do
            ls -hl $i
            head ${i%.*}.idx

            tty -s && { ry || continue; }

            rm -f ${i%.*}.*
        done ;;
    r)
        for i in $(ls -t $t/*.idx); do
            if grep -i "$x" $i; then
                d=$(head -1 $i)
                a=${i%.*}.tar

                echo $d
                ls -hl $a

                ry || continue

                cd "$d"
                tar -x -f $a -Pkv
                rm -f ${i%.*}.*

                break
            fi
        done ;;
    *)
        b=$t/$(date +%s)

        pwd > $b.idx

        tar -c -f $b.tar -Pv $z "$@" | tee -a $b.idx

        [ $w ] && touch -d "-$(($u - 7)) days" $b.*

        [ $k ] || rm -fr "$@"

        ls -hl $b.tar ;;
esac
